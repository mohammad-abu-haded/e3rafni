generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum RoundMode {
  SINGLE_QUESTION
  CONTINUOUS_QUESTIONS
}

enum RoundMemberType {
  PLAYER
  VIEWER
  RULER
}


enum RoundStatus {
  WAITING
  PLAYING
  FINISHED
}

model Users {
  id Int @id @default(autoincrement())
  role Role @default(USER)
  name String
  email String @unique
  password String?
  googleId String? @unique
  picture String?
  createdAt DateTime @default(now())
  
  ownedRooms Rooms[]
  roomMembers RoomMembers[]
}

model Rooms {
  id Int @id @default(autoincrement())
  name String
  totalRounds Int
  currentRound Int
  createdAt DateTime @default(now())
  ownerId Int
  code String @unique
  isPrivate Boolean @default(false)
  capacity Int @default(10)
  owner Users @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  isActive Boolean @default(true)
  roomMembers RoomMembers[]
  roomRounds Rounds[]
  roomCards Cards[]
}

model Cards {
  id String @id @default(cuid())
  roomId Int
  title String
  description String
  color String
  maxPerPlayer Int

  room Rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)

  usages PlayerCardUsages[]

  @@index([roomId])
}

model PlayerCardUsages {
  id Int @id @default(autoincrement())
  roomId Int
  roundId Int
  userId Int
  cardId String
  usedAt DateTime @default(now())

  roundMember RoundMembers @relation(fields: [roundId, userId], references: [roundId, userId], onDelete: Cascade)
  card Cards @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([roomId, userId, cardId])
  @@index([roundId, userId, cardId])
}

model RoomMembers {
  roomId Int
  userId Int
  wins   Int @default(0)
  room Rooms @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@id([roomId, userId])
  @@index([userId])
 
  roundMembers RoundMembers[]
}

model Rounds {
  id Int @id @default(autoincrement())
  roomId Int
  roundNumber Int
  roundDuration Int
  startedAt DateTime @default(now())
  mode RoundMode @default(SINGLE_QUESTION)
  status RoundStatus @default(WAITING)
  room Rooms @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([id, roomId])
  @@unique([roomId, roundNumber])
  @@index([roomId])
  roundMembers RoundMembers[]
  roundWords RoundWords[]
}

model RoundMembers {
  roundId Int
  roomId Int 
  userId Int
  type RoundMemberType
  round Rounds @relation(fields: [roundId, roomId], references: [id, roomId], onDelete: Cascade, onUpdate: Cascade)
  roomMember RoomMembers @relation(fields: [roomId, userId], references: [roomId, userId], onDelete: Cascade, onUpdate: Cascade)
  @@id([roundId, userId])
  @@index([roundId, type])

  roundWords RoundWords[]
  cardUsages PlayerCardUsages[]
}

model RoundWords {
  id Int @id @default(autoincrement())
  roundId Int
  playerId Int
  word String
  round Rounds @relation(fields: [roundId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roundMembers RoundMembers @relation(fields: [roundId, playerId], references: [roundId, userId], onDelete: Cascade, onUpdate: Cascade)
  @@unique([roundId, playerId])
  @@index([roundId])
}